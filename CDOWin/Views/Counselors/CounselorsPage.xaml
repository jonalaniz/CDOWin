<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CDOWin.Views.Counselors.CounselorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:counselors="using:CDO.Core.DTOs.Counselors"
    xmlns:clients="using:CDO.Core.DTOs.Clients"
    xmlns:dto="using:CDO.Core.DTOs.SAs"
    xmlns:c="using:CDO.UI.Shared.Controls"
    mc:Ignorable="d">

    <Grid>
        <!-- Columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Column -->
        <Grid Style="{StaticResource ContentRightBorderStyle}">

            <!-- Rows -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Columns -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource PageTitleStyle}"
                       Text="Counselors"/>
            
            <!-- CommandBar -->
            <CommandBar Grid.Row="0" Grid.Column="1" Style="{StaticResource CommandBarDefaultStyle}">
                <AppBarButton Width="56" IsCompact="False" ToolTipService.ToolTip="New Counselor"
                              Click="NewCounselor_ClickAsync">
                    <FontIcon Style="{StaticResource SingleIconFontStyle}" Glyph="&#xE710;"/>
                </AppBarButton>
            </CommandBar>

            <!-- Search Bar -->
            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                     Margin="8,0,8,8" PlaceholderText="Filter Counselors"
                     Text="{x:Bind _viewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            
            <!-- Counselors List -->
            <ListView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Style="{StaticResource SummaryListViewStyle}"
                      SelectedItem="{x:Bind _viewModel.SelectedSummary, Mode=TwoWay}"
                      ItemsSource="{x:Bind _viewModel.Filtered, Mode=OneWay}"
                      ItemClick="ListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="counselors:CounselorSummary">
                        <Grid Margin="0,10,8,12">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{x:Bind Name}"
                                       FontWeight="Bold" 
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" 
                                       Text="{x:Bind FormattedCaseLoadID}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" 
                                       Text="{x:Bind Phone}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>                        
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Status Bar -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                  Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource ListStatusBarStyle}">
                    <Run Text="{x:Bind _viewModel.Filtered.Count, Mode=OneWay}"/>
                    <Run Text="Counselors"/>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Right Column -->
        <Grid Grid.Column="1"
              Visibility="{x:Bind _viewModel.Selected, Mode=OneWay, Converter={StaticResource NullToVisability}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Bind _viewModel.Selected.Name, Mode=OneWay}"
                       Style="{StaticResource PageTitleStyle}"/>

            <!-- CommandBar -->
            <CommandBar Grid.Row="0" Grid.Column="1" Style="{StaticResource CommandBarDefaultStyle}">
                <AppBarButton IsCompact="False" ToolTipService.ToolTip="Edit" Click="EditButton_Click">
                    <FontIcon Glyph="&#xE70F;" Style="{StaticResource SingleIconFontStyle}"/>
                </AppBarButton>
                
                <AppBarButton Width="56" IsCompact="False" ToolTipService.ToolTip="More">
                    <AppBarButton.Icon>
                        <FontIcon Style="{StaticResource SingleIconFontStyle}" Glyph="&#xE712;"/>
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Delete..." Click="Delete_MenuFlyoutItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Style="{StaticResource DeleteSymbolIcon}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            
            <!-- Detail Cards Section -->
            <ScrollView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HorizontalScrollView}">
                <StackPanel Padding="8,0" Orientation="Horizontal" Spacing="10">
                    
                    <!-- Details Card -->
                    <Grid Style="{StaticResource CardContainerGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Padding="0,0,0,4" Style="{StaticResource CDOCardHeaderContainerStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Details" Style="{StaticResource BackstageCardTitle}"/>
                        </Grid>

                        <!-- Content -->
                        <ScrollViewer Grid.Row="1">
                            <Grid Style="{StaticResource CDOCardContentContainerStyle}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 2: ACE ID + Case Load -->
                                <c:LabelPair Grid.Row="0" Grid.Column="0"
                                             Label="ACE ID" Value="{x:Bind _viewModel.Selected.Id, Mode=OneWay}"/>
                                <c:LabelPair Grid.Row="0" Grid.Column="1" 
                                             Label="Case Load" Value="{x:Bind _viewModel.Selected.CaseLoadId, Mode=OneWay}"/>

                                <!-- Row 1: Email -->
                                <c:LabelPair Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                             Label="Email" Value="{x:Bind _viewModel.Selected.Email, Mode=OneWay}"/>

                                <!-- Row 2: Phone + Fax -->
                                <c:LabelPair Grid.Row="2" Grid.Column="0"
                                             Label="Phone" Value="{x:Bind _viewModel.Selected.Phone, Mode=OneWay}"/>
                                <c:LabelPair Grid.Row="2" Grid.Column="1" 
                                             Label="Fax" Value="{x:Bind _viewModel.Selected.Fax, Mode=OneWay}"/>

                                <!-- Row 3: Secretary -->
                                <c:LabelPair Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                             Label="Secretary" Value="{x:Bind _viewModel.Selected.SecretaryName, Mode=OneWay}"/>

                                <!-- Row 4: Secretary -->
                                <c:LabelPair Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                                             Label="Secretary Email" Value="{x:Bind _viewModel.Selected.SecretaryEmail, Mode=OneWay}"/>

                                <!-- Row 5: Notes -->
                                <c:LabelPair Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                                             Label="Notes" Value="{x:Bind _viewModel.Selected.Notes, Mode=OneWay}"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- SAs Card -->
                    <Grid Style="{StaticResource CardContainerGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Padding="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Service Authorizations" Style="{StaticResource BackstageCardTitle}"/>
                        </Grid>

                        <!-- Item Repeater -->
                        <ScrollViewer Grid.Row="1">
                            <ItemsRepeater ItemsSource="{x:Bind _viewModel.Selected.Sas, Mode=OneWay}">
                                <DataTemplate x:DataType="dto:SADetail">

                                    <!-- Button -->
                                    <Button Style="{StaticResource BackstageListButton}" Tag="{x:Bind Id}">
                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" FontWeight="Bold" Text="{x:Bind ClientName}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ServiceAuthorizationNumber}"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Description}"/>
                                            <TextBlock Text="{x:Bind FormattedDateRange}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </ScrollView>
            
            <!-- Clients Table -->
            <ListView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                      Style="{StaticResource DataTableStyle}"
                      BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1"
                      ItemsSource="{x:Bind _viewModel.Clients, Mode=OneWay}">

                <!-- Header -->
                <ListView.Header>
                    <Grid Style="{StaticResource DataTableHeaderStyle}">

                        <interactivity:Interaction.Behaviors>
                            <behaviors:StickyHeaderBehavior/>
                        </interactivity:Interaction.Behaviors>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Name" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Case ID"/>
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Address" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Phone"/>
                    </Grid>
                </ListView.Header>

                <!-- Content -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="clients:ClientSummary">
                        <Grid Padding="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="{x:Bind FormattedName}"
                                           TextWrapping="WrapWholeWords" FontWeight="Bold"/>
                                <Button Grid.Column="1" 
                                        Style="{StaticResource AccentButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Click="GoToClient_Click">
                                    <FontIcon Glyph="&#xE76C;"/>
                                </Button>
                            </Grid>
                            <TextBlock Grid.Column="1" 
                                       Text="{x:Bind CaseID}"/>
                            <TextBlock Grid.Column="2" 
                                       Text="{x:Bind FormattedAddress}" 
                                       TextWrapping="WrapWholeWords"/>
                            <TextBlock Grid.Column="3" 
                                       Text="{x:Bind Phone}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Status Bar -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                  Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource ListStatusBarStyle}">
                    <Run Text="{x:Bind _viewModel.Clients.Count, Mode=OneWay}"/>
                    <Run Text="Client(s)"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Page>
