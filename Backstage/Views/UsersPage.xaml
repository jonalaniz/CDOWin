<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Backstage.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Backstage.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:dto="using:CDO.Core.DTOs.Admin"
    xmlns:activities="using:CDO.Core.DTOs.Activities"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="336"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Grid Grid.RowSpan="2" Style="{StaticResource ContentRightBorderStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Column="0" Text="Users" Padding="8" Style="{StaticResource BackstageHeader}"/>

                <!-- CommandBar -->
                <CommandBar Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CommandBarDefaultStyle}">
                    <AppBarButton Width="56" Click="Refresh_ItemCLick"  IsCompact="False" ToolTipService.ToolTip="New Client">
                        <FontIcon Glyph="&#xE72C;" Style="{StaticResource SingleIconFontStyle}"/>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <!-- Search Bar -->
            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                     Margin="8,0,8,8" 
                     PlaceholderText="Filter Users"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- ServiceAuthorizations Table -->
            <ListView x:Name="ListView"
                      Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Style="{StaticResource DataTableStyle}" 
                      ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}" 
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" 
                      ItemClick="ListView_ItemClick">

                <!-- Header -->
                <ListView.Header>
                    <Grid Style="{StaticResource DataTableHeaderStyle}">

                        <interactivity:Interaction.Behaviors>
                            <behaviors:StickyHeaderBehavior/>
                        </interactivity:Interaction.Behaviors>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Username" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="First Name" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Last Name" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Admin" FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>

                <!-- Content -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dto:UserSummary">
                        <Grid Padding="12,8" Opacity="{x:Bind Inactive, Converter={StaticResource BoolOpacityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Username}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind FirstName}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind LastName}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Admin}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Row 3: Status Bar -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                  Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource ListStatusBarStyle}">
                    <Run Text="{x:Bind ViewModel.Users.Count, Mode=OneWay}"/>
                    <Run Text="Users"/>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Right Column -->
        <Grid Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource ContentRightBorderStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Details" Padding="12,8" Style="{StaticResource BackstageHeader}"/>
            
            <!-- History List -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderThickness="0,1" BorderBrush="{StaticResource DividerStrokeColorDefault}"
                        Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}">
                    <TextBlock Grid.Row="0" Padding="12,8" FontWeight="Bold" Text="History"/>
                </Border>
                
                <!-- User History Table -->
                <ScrollViewer Grid.Row="1">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedUserHistory.Activities, Mode=OneWay}">
                        <DataTemplate x:DataType="activities:UserActivity">
                            <Grid Padding="12" BorderThickness="0,0,0,1">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Name + Date -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               HorizontalAlignment="Left" FontWeight="Bold" Text="{x:Bind ClientName}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               HorizontalAlignment="Right" FontWeight="Bold" Text="{x:Bind FormattedDate}"/>

                                    <!-- Row 1: Text -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind Action}"/>
                                </Grid>
                            </Grid>
                                    
                        </DataTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
