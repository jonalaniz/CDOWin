<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CDOWin.Views.Employers.Inspectors.EmployerInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDOWin.Views.Employers.Inspectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:c="using:CDO.UI.Shared.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="0" Background="{ThemeResource CardBackgroundFillColorSecondary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Command Bar -->
        <Grid Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerStrokeColorDefault}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource PageTitleStyle}"
                       Text="{x:Bind _viewModel.Selected.Name, Mode=OneWay}"
                       TextWrapping="WrapWholeWords"/>

            <CommandBar Grid.Column="1" Style="{StaticResource CommandBarDefaultStyle}">
                <AppBarButton Width="56" IsCompact="False" ToolTipService.ToolTip="Edit"
                              Click="EditButton_Click">
                    <FontIcon Glyph="&#xE70F;" Style="{StaticResource SingleIconFontStyle}"/>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Details Header -->
                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerStrokeColorDefault}"
                        Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}">
                    <TextBlock Padding="16,8" FontWeight="Bold" Text="Details"/>
                </Border>

                <!-- Row 1: Details Content -->
                <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8" Padding="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Address -->
                    <c:LabelPair Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Label="Address"
                                 Value="{x:Bind _viewModel.Selected.FormattedAddress, Mode=OneWay}"/>

                    <!-- Row 1: Phone + Fax -->
                    <c:LabelPair Grid.Row="1" Grid.Column="0" Label="Phone" 
                                 Value="{x:Bind _viewModel.Selected.Phone, Mode=OneWay}"/>
                    <c:LabelPair Grid.Row="1" Grid.Column="1" Label="Fax" 
                                 Value="{x:Bind _viewModel.Selected.Fax, Mode=OneWay}"/>

                    <!-- Row 2: Supervisor -->
                    <c:LabelPair Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Label="Supervisor" 
                                 Value="{x:Bind _viewModel.Selected.FormattedSupervisor, Mode=OneWay}"/>
                    
                    <!-- Row 3: Website -->
                    <c:LabelPair Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Label="Website" 
                                 Value="{x:Bind _viewModel.Selected.Website, Mode=OneWay}"/>
                    
                    <!-- Row 4: Notes -->
                    <c:LabelPair Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Label="Notes" 
                                 Value="{x:Bind _viewModel.Selected.Notes, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
