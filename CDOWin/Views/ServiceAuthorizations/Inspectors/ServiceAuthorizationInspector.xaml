<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CDOWin.Views.ServiceAuthorizations.Inspectors.ServiceAuthorizationInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDOWin.Views.ServiceAuthorizations.Inspectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:c="using:CDO.UI.Shared.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="0" Background="{ThemeResource CardBackgroundFillColorSecondary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Command Bar -->
        <Grid Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerStrokeColorDefault}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource PageTitleStyle}"
                       Text="{x:Bind _viewModel.Selected.ClientName, Mode=OneWay}"
                       TextWrapping="WrapWholeWords"/>

            <CommandBar Grid.Column="1" Style="{StaticResource CommandBarDefaultStyle}">
                <AppBarButton Width="56" IsCompact="False" ToolTipService.ToolTip="Edit"
                              Click="EditButton_Click">
                    <FontIcon Glyph="&#xE70F;" Style="{StaticResource SingleIconFontStyle}"/>
                </AppBarButton>

                <!-- More Menu -->
                <AppBarButton Width="56" IsCompact="False" ToolTipService.ToolTip="More">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE712;" Style="{StaticResource SingleIconFontStyle}"/>
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Export..." Click="Export_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="OpenFile" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Delete..." Click="Delete_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Style="{StaticResource DeleteSymbolIcon}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Details Header -->
                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerStrokeColorDefault}"
                        Background="{StaticResource AcrylicBackgroundFillColorDefaultBrush}">
                    <TextBlock Padding="16,8" FontWeight="Bold" Text="Details"/>
                </Border>
                
                <!-- Row 1: Details Content -->
                <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8" Padding="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: SA Number + Case ID-->
                    <c:LabelPair Grid.Row="0" Grid.Column="0" Label="SA Number" 
                                 Value="{x:Bind _viewModel.Selected.ServiceAuthorizationNumber, Mode=OneWay}"/>
                    <c:LabelPair Grid.Row="0" Grid.Column="1" Label="Case ID"
                                 Value="{x:Bind _viewModel.Selected.CaseId, Mode=OneWay}"/>

                    <!-- Row 1: Counselor -->
                    <c:LabelPair Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Label="Issued By"
                                 Value="{x:Bind _viewModel.Selected.CounselorName, Mode=OneWay}"/>

                    <!-- Row 2: Office -->
                    <c:LabelPair Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Label="Office"
                                 Value="{x:Bind _viewModel.Selected.Office, Mode=OneWay}"/>

                    <!-- Row 3: Secretary -->
                    <c:LabelPair Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Label="Secretary"
                                 Value="{x:Bind _viewModel.Selected.SecretaryName, Mode=OneWay}"/>

                    <!-- Row 4: Start Date + End Date -->
                    <c:LabelPair Grid.Row="4" Grid.Column="0" Label="Start Date" 
                                 Value="{x:Bind _viewModel.Selected.FormattedStartDate, Mode=OneWay}"/>
                    <c:LabelPair Grid.Row="4" Grid.Column="1" Label="End Date" 
                                 Value="{x:Bind _viewModel.Selected.FormattedEndDate, Mode=OneWay}"/>

                    <!-- Row 5: Unit Cost -->
                    <c:LabelPair Grid.Row="5" Grid.Column="0" Label="Unit Cost" 
                                 Value="{x:Bind _viewModel.Selected.FormattedCost, Mode=OneWay}"/>
                    <c:LabelPair Grid.Row="5" Grid.Column="1" Label="U/M" 
                                 Value="{x:Bind _viewModel.Selected.UnitOfMeasurement, Mode=OneWay}"/>

                    <!-- Row 6: Description -->
                    <c:LabelPair Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Label="Description" 
                                 Value="{x:Bind _viewModel.Selected.Description, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
